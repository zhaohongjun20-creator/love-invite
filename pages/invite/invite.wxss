.wrap {
  min-height: 100vh;
  padding: 24rpx 48rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ---------------- 步骤指示器 ---------------- */
.steps {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  margin-bottom: 6rpx;
}
.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 96rpx;
}
.dot {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: var(--fv-tint);
  color: #d2a5b4;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all .25s;
}
.dot.on {
  background: linear-gradient(135deg, var(--fv-accent2), var(--fv-accent));
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(var(--fv-shadow), .3);
}
.dot-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #c4aab4;
}
.dot-label.on { color: var(--fv-accent); font-weight: 600; }
.step-line {
  width: 88rpx;
  height: 4rpx;
  background: var(--fv-tint);
  border-radius: 4rpx;
  margin-top: 22rpx;
}
.step-line.on { background: var(--fv-tint2); }

/* ---------------- 角色 & 台词 ---------------- */
.girl { margin-top: 6rpx; }

.bubble-main {
  width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
  text-align: center;
}

/* ---------------- 选项面板 ---------------- */
.panel {
  width: 100%;
  margin-top: 40rpx;
  animation: rise .4s ease-out;
}
@keyframes rise {
  from { opacity: 0; transform: translateY(24rpx); }
}

.opts { display: flex; flex-direction: column; }

.opt {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, var(--fv-opt1), var(--fv-opt2));
  border: 2rpx solid var(--fv-border);
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 18rpx;
  transition: all .18s;
}
.opt:active {
  transform: scale(1.02);
  background: var(--fv-tint2);
  box-shadow: 0 10rpx 22rpx rgba(var(--fv-shadow), .22);
}
.opt .ico { font-size: 40rpx; margin-right: 18rpx; }
.opt .txt {
  flex: 1;
  font-size: 29rpx;
  color: var(--fv-mid);
  line-height: 1.4;
}

/* 自定义输入 */
.opt.custom {
  background: #fff;
  border-style: solid;
  padding: 14rpx 20rpx;
}
.opt.custom:active { transform: none; background: #fff; box-shadow: none; }
.opt.sender-row { margin-bottom: 28rpx; border-color: var(--fv-border); }
.ipt {
  flex: 1;
  font-size: 28rpx;
  color: var(--fv-accent-deep);
  padding: 10rpx 6rpx;
}
.ipt-ph { color: #d8aab6; font-size: 25rpx; }
.mini {
  background: linear-gradient(135deg, var(--fv-accent2), var(--fv-accent));
  color: #fff;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  font-size: 25rpx;
  margin-left: 12rpx;
  white-space: nowrap;
}
.mini:active { transform: scale(.94); opacity: .9; }

/* 日期行 */
.opt.date-row { padding: 16rpx 20rpx; flex-wrap: wrap; }
.opt.date-row:active { transform: none; }
.pk {
  background: var(--fv-opt1);
  border: 2rpx dashed #f8b3c3;
  border-radius: 14rpx;
  padding: 10rpx 16rpx;
  margin-right: 12rpx;
}
.pk-text { font-size: 26rpx; color: var(--fv-accent-deep); }

/* 上一步 */
.back {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #b9a3ad;
  padding: 16rpx 30rpx;
}
.back:active { color: var(--fv-accent); }

.safe-pad { height: 200rpx; }

/* ---------------- 躲猫猫拒绝按钮 ---------------- */
.no-btn {
  position: fixed;
  z-index: 30;
  background: #fff;
  border: 2rpx dashed var(--fv-accent2);
  color: var(--fv-accent);
  border-radius: 999rpx;
  padding: 18rpx 34rpx;
  font-size: 27rpx;
  box-shadow: 0 10rpx 24rpx rgba(var(--fv-shadow), .25);
  transition: left .18s ease-out, top .18s ease-out, transform .18s;
  max-width: 60vw;
}
