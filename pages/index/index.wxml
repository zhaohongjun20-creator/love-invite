<view class="cover" bindtap="onTapAnywhere">

  <!-- 飘落的爱心 -->
  <view
    wx:for="{{hearts}}"
    wx:key="id"
    class="bg-heart"
    style="left:{{item.left}}; font-size:{{item.size}}rpx; animation-duration:{{item.dur}}s; animation-delay:{{item.delay}}s;"
  >{{item.char}}</view>

  <!-- 角色 -->
  <view class="girl">
    <anime-girl mood="{{mood}}" size="lg" set="{{charSet}}" />
  </view>

  <!-- 角色切换：女生 / 男生 -->
  <view class="char-switch">
    <view
      wx:for="{{charOptions}}"
      wx:key="key"
      class="cs-item {{charSet === item.key ? 'on' : ''}}"
      data-key="{{item.key}}"
      catchtap="onSwitchChar"
    >{{item.avatar}} {{item.label}}</view>
  </view>

  <!-- 台词气泡 -->
  <view class="bubble-wrap" catchtap="onChangeLine">
    <view class="bubble">{{line}}</view>
  </view>

  <!-- 标题 -->
  <view class="title">约会小软件</view>
  <view class="slogan">和 {{charName}} 一起，把这一天定下来</view>

  <!-- 主按钮 -->
  <view class="btn-main start-btn" catchtap="onStart">💌 发起约会邀请</view>

  <!-- 次入口 -->
  <view class="btn-ghost sub-btn" catchtap="onReply">🔑 我有邀请码 · 去答复 TA</view>
  <view wx:if="{{hasCodes}}" class="btn-ghost sub-btn" catchtap="onMine">
    📮 我发起的邀请{{repliedCount > 0 ? ' · 有 ' + repliedCount + ' 条回复' : ''}}
  </view>

  <!-- 上次的约会 -->
  <view wx:if="{{plan}}" class="card last" catchtap="onViewLast">
    <view class="last-head">
      <text class="last-title">上次定下的约会</text>
      <text wx:if="{{countText}}" class="countdown">{{countText}}</text>
    </view>
    <view class="last-row">🕐 {{plan.time}}</view>
    <view class="last-row">📍 {{plan.place}}</view>
    <view class="last-row">💫 {{plan.act}}</view>
    <view class="last-tip">点这里查看清单卡片 →</view>
  </view>

  <!-- 音乐开关 -->
  <view class="music-btn" catchtap="onToggleMusic">{{musicIcon}}</view>
</view>

<!-- 躲猫猫的拒绝按钮（和原版一样，第一屏就有） -->
<view
  class="no-btn"
  style="left:{{noLeft}}px; top:{{noTop}}px; transform:scale({{noScale}});"
  catchtap="onNoTap"
>{{noText}}</view>
