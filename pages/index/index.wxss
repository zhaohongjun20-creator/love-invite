.cover {
  position: relative;
  min-height: 100vh;
  padding: 20rpx 56rpx 80rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

.girl { margin-top: 10rpx; }

.bubble-wrap { width: 100%; margin-top: 34rpx; }

.title {
  margin-top: 44rpx;
  font-size: 58rpx;
  font-weight: 700;
  color: #e8556e;
  letter-spacing: 6rpx;
  text-shadow: 0 6rpx 16rpx rgba(232, 85, 110, .18);
}

.slogan {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #a58c97;
  letter-spacing: 1rpx;
}

.start-btn {
  width: 100%;
  margin-top: 48rpx;
}

.last {
  width: 100%;
  margin-top: 34rpx;
  padding: 30rpx 32rpx;
}
.last-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.last-title { font-size: 30rpx; font-weight: 600; color: #e8556e; }
.countdown {
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff8fb0, #e8556e);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.last-row {
  font-size: 27rpx;
  color: #7a5a68;
  line-height: 1.9;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.last-tip {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #b9a3ad;
  text-align: right;
}

.music-btn {
  position: fixed;
  right: 32rpx;
  top: 32rpx;
  z-index: 20;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .92);
  border: 2rpx solid #ffc9d4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 10rpx 26rpx rgba(232, 85, 110, .2);
}
